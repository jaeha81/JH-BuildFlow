# API 서버 URL (프로덕션 빌드 시 필수)
# 개발 환경: http://localhost:8000 (자동)
VITE_API_BASE_URL=https://api.your-domain.com

# 화이트라벨: 앱 이름 오버라이드
APP_PRODUCT_NAME=JH BuildFlow 관리자

# 화이트라벨: appId 오버라이드
APP_ID=com.jh.contractor-platform

# 자동 업데이트 서버 URL (없으면 업데이트 비활성)
UPDATE_SERVER_URL=

# 코드 서명 (프로덕션 배포 시만 필요)
# WIN_CERT_FILE=path/to/cert.p12
# WIN_CERT_PASSWORD=your-cert-password
