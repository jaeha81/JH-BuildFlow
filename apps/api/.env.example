# ============================================================
# JH BuildFlow API — Environment Variables Template
# Railway에서는 이 파일 없이 환경변수 패널에서 직접 입력
# ============================================================

# --- Database (Railway PostgreSQL 애드온이 자동 주입) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_SYNC_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- JWT ---
SECRET_KEY=change-me-minimum-32-characters-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_ENV=production
APP_PORT=8000

# Vercel 배포 후 실제 URL로 교체 (콤마 구분)
ALLOWED_ORIGINS=https://your-vendor-web.vercel.app,https://your-admin-web.vercel.app

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./uploads
