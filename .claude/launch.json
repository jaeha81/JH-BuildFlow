{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vendor-web (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/vendor-web"],
      "port": 3000
    },
    {
      "name": "admin-desktop renderer (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:renderer", "--prefix", "apps/admin-desktop"],
      "port": 5173
    },
    {
      "name": "admin-web (Next.js)",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd apps/admin-web && npm install && npm run dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "launch-guide (static)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4000", "--directory", "guide"],
      "port": 4000
    }
  ]
}
